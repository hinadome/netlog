# HTTPS FrontendGateway for Netlog Lens (--self-signed / --certbot)
# Certificates: __SSL_DIR__/fullchain.pem + privkey.pem (files or LE symlinks)
# Does not claim default_server — coexists with other nginx apps.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root __CERTBOT_WEBROOT__;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __SSL_DIR__/fullchain.pem;
    ssl_certificate_key __SSL_DIR__/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    root __WWW_DIR__;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log /var/log/nginx/__APP_NAME__.access.log;
    error_log  /var/log/nginx/__APP_NAME__.error.log;
}
